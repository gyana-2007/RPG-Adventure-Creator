# ===================================================================
# Text-Based RPG Adventure Creator - Environment Variables
# ===================================================================

# 1. Google Gemini AI API Key (Server-side only)
# Get a free key at: https://aistudio.google.com/
# NEVER prefix with NEXT_PUBLIC_ so it remains hidden from the browser.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Cloud Persistence (Optional - Local Storage Fallback is Active)
# Create a free project at: https://supabase.com/
# Copy from Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
